{
  // 只给本地 `wrangler pages dev` 和 `wrangler d1 migrations` 用。
  // 故意不写 pages_build_output_dir。写上之后，Pages 的 Git 部署会把本文件当成绑定的唯一来源，
  // 冲掉控制台里已有的 STATS_KV。不要对本文件执行 `wrangler pages deploy`。
  // database_id 是占位，远程库还不存在。创建后换成 `wrangler d1 create unnoticed` 打印的 id，再跑远程迁移。
  "name": "mangofund",
  "compatibility_date": "2026-11-10",
  "d1_databases": [
    {
      "binding": "UNNOTICED_DB",
      "database_name": "unnoticed",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "preview_database_id": "local-unnoticed",
      "migrations_dir": "migrations"
    }
  ]
}
